# Telegram bot token from BotFather. Required.
TELEGRAM_BOT_TOKEN=

# MongoDB connection string. Required for catalog, users, VIPs, tasks, and stats.
MONGODB_URI=

# Private Telegram storage channel ID where the bot is an admin.
# Example: -1001234567890
STORAGE_CHANNEL_ID=

# Comma-separated Telegram numeric user IDs that can access admin features.
BOT_ADMIN_IDS=

# Optional text shown to free users when they request VIP access.
VIP_CONTACT_TEXT=

# Optional default VIP duration in days. Falls back to 30.
DEFAULT_VIP_DAYS=30

# Optional comma-separated sponsor channel/group IDs users must join before access.
# This must not include the private storage channel.
SPONSOR_CHAT_IDS=

# Optional comma-separated public/private invite URLs for sponsor join buttons.
SPONSOR_JOIN_URLS=

# Optional VIP expiry loop interval in milliseconds. Falls back to 300000.
VIP_EXPIRY_CHECK_MS=300000
